next_season_end = pd.Timestamp('2022-12-26')

breakout_list = []
for pid, rank_start in zip(eligible['player_id'], eligible['rank_start']):
    next_rank = get_rank(pid, next_season_end)
    if next_rank is None:
        breakout = None  # no ranking data next season (retired, injured, etc.)
    else:
        breakout = (next_rank <= rank_start / 2) or (next_rank <= 50)
    breakout_list.append({'player_id': pid, 'next_rank': next_rank, 'breakout': breakout})

breakout_df = pd.DataFrame(breakout_list)
